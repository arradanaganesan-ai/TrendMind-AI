# Frontend environment (build-time only)
# Copy this file to `.env.local` and adjust if the backend runs elsewhere.
# NEVER put server secrets (SerpApi keys, AI keys) in VITE_ variables —
# anything prefixed VITE_ is embedded in the browser bundle.

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_VERSION=1.0.0
# Optional: link shown in the landing footer and About page.
VITE_GITHUB_REPO_URL=
