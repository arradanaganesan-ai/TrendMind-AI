# ============================================================
# TrendMind AI — environment configuration (placeholders only)
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file.
# ============================================================

# --- Backend server ---
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Directory for the SQLite database file (must be writable).
DATABASE_PATH=./data/trendmind.db

# --- SerpApi live search (https://serpapi.com) ---
# Leave empty to run in Demo Mode (clearly labeled mock data, no credits used).
SERPAPI_API_KEY=
# Search engine to use with SerpApi.
SERPAPI_ENGINE=google
# Request timeout in seconds for the search API.
SEARCH_TIMEOUT_SECONDS=10
# Server-side maximum number of search results per request.
MAX_RESULTS_LIMIT=20

# --- Source content extraction (SSRF-protected) ---
# Enable fetching of publicly accessible pages found in search results.
ENABLE_SOURCE_EXTRACTION=true
# Maximum number of pages to fetch per research run.
MAX_EXTRACT_PAGES=3
# Timeout per page fetch, in seconds.
EXTRACT_TIMEOUT_SECONDS=8
# Maximum bytes downloaded per page.
MAX_PAGE_BYTES=1500000
# Maximum characters of extracted text kept per page.
MAX_EXTRACT_CHARS=12000

# --- AI provider (optional) ---
# Supported: none | openai_compatible | anthropic
#   none             -> deterministic basic analysis (clearly labeled, no LLM)
#   openai_compatible-> any provider implementing POST {AI_BASE_URL}/chat/completions
#                      (OpenAI, OpenRouter, Groq, local gateways, etc.)
#   anthropic        -> POST https://api.anthropic.com/v1/messages
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45
# Optional cap on AI input size (characters of evidence passed to the model).
AI_MAX_EVIDENCE_CHARS=24000

# --- Rate limiting ---
# Requests per minute allowed per client on POST /api/research.
RESEARCH_RATE_LIMIT_PER_MINUTE=6

# --- Frontend (build-time only — no secrets ever go here) ---
# Vite reads this file from frontend/.env.local — see README.
VITE_API_BASE_URL=http://localhost:8000

# --- Links shown in the landing page footer ---
GITHUB_REPO_URL=
